# === secrets — NEVER ship these ===
.env
.env.*
*.key
**/SKILLCUSTOMIZATIONS/**/.env

# === machine-local / identity (usernames, absolute paths, session logs) ===
# NOTE: .gitignore has no inline comments — keep each pattern on its own line.
.claude/settings.local.json
# PAI session PRDs — local work state, not the skill:
/MEMORY/

# === per-investigation data (target data + your analysis) — keep private ===
# Comment these out if you deliberately want to share example cases.
# UNANCHORED so a stray cases/ or knowledge/ created anywhere (e.g. the harness run
# from a subdir) is ALSO ignored — but re-include the shippable eval golden-set fixtures.
cases/
knowledge/
knowledge_scratch/
!tools/eval/cases/
!tools/eval/cases/**
# stray per-investigation artifacts that live OUTSIDE cases/ (target lists, host dumps)
# — the cases/ rule above does not match root-level files like cases_<x>_hosts.txt
cases_*.txt
*_hosts.txt

# === OS / Python cruft ===
.DS_Store
**/.DS_Store
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.playwright-cli/
# local virtualenvs — machine-specific, never ship with a portable skill
.venv/
**/.venv/

# === large scraped inputs ===
malicious.html
