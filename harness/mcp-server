#!/usr/bin/env bash
# Launch shim for the harness MCP server. Referenced by the repo-root .mcp.json so Claude Code
# (or any MCP client) can start it. tools.py imports claude_agent_sdk, so it must run under a
# Python that has the SDK — the WebPivot venv. Resolves paths from its own location, so it works
# regardless of the caller's cwd. If your SDK venv lives elsewhere, change PY below (one line).
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$here/../WebPivot/.venv/bin/python3"
exec "$PY" "$here/mcp_server.py"
